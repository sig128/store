# ─────────────────────────────────────────────────────────────────────────────
# After Hours Athletics — environment
# Copy to .env (development) or set in your host's secret manager (production).
# Secrets live ONLY here — never in NEXT_PUBLIC_* variables, never in the database.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
# Production enables the launch gate: checkout stays closed until /admin/readiness passes,
# the payment simulator is unavailable, and only approved data is shown to customers.
APP_ENV=development
# Public base URL, used for provider return URLs, webhooks you register, emails and the sitemap.
APP_URL=http://localhost:3000

# PostgreSQL 16+
DATABASE_URL=postgres://aha:change-me@127.0.0.1:5432/aha_dev
# DB_POOL_MAX=10

# 32+ random characters each. Generate with:  openssl rand -base64 48
COOKIE_SECRET=
BETTER_AUTH_SECRET=
# Optional; defaults to APP_URL
# BETTER_AUTH_URL=

# ── Payments ────────────────────────────────────────────────────────────────
# Local simulator for development and tests ("1" to enable). Ignored when APP_ENV=production.
PAYMENTS_SIMULATOR=1

# Stripe Checkout. Use sk_test_… keys for the sandbox; sk_live_… only at launch.
# Stripe is "connected" only when both the key and the webhook signing secret are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Checkout payment method types. "card" also offers eligible wallets
# (Apple Pay / Google Pay). Leave empty to use the methods enabled in the Stripe Dashboard.
STRIPE_PAYMENT_METHOD_TYPES=card

# PayPal Orders v2 (REST app credentials from developer.paypal.com).
# PayPal is "connected" only when client id, secret and webhook id are all set.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Email ───────────────────────────────────────────────────────────────────
# log (prints to the console — development only) | resend | smtp
EMAIL_PROVIDER=log
EMAIL_FROM="After Hours Athletics <orders@example.com>"
# EMAIL_REPLY_TO=support@example.com
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# ── Media storage ───────────────────────────────────────────────────────────
# local (disk; needs a persistent volume) | s3 (AWS S3, Cloudflare R2, MinIO, …)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public (CDN) base URL for product images, e.g. https://media.example.com
# Print files are stored under print-files/ and must NOT be publicly readable.
# S3_PUBLIC_BASE_URL=

# ── Fulfilment ──────────────────────────────────────────────────────────────
# manual (packing slip + supplier sheet) | pod (adapter stub — no provider integrated yet)
FULFILLMENT_PROVIDER=manual
# POD_API_KEY=
# POD_API_BASE=

# ── Background jobs ─────────────────────────────────────────────────────────
# Either run `npm run worker` as a long-lived process, or call
#   POST /api/cron/tick  with header  Authorization: Bearer $CRON_SECRET
# every minute from a scheduler.
CRON_SECRET=
# WORKER_POLL_MS=2000

# ── Development helpers (seed / tests) ──────────────────────────────────────
# SEED_ADMIN_EMAIL=owner@afterhours.test
# SEED_ADMIN_PASSWORD=
# TEST_DATABASE_URL=postgres://aha:change-me@127.0.0.1:5432/aha_test
